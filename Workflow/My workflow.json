    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalRevenue = 0;\nlet totalQuantity = 0;\n\nlet topProduct = \"\";\nlet topProductSales = 0;\n\nlet categorySales = {};\nlet regionSales = {};\n\nfor (const item of items) {\n\n  const sales = Number(item.json[\"Sales ($)\"]) || 0;\n  const qty = Number(item.json[\"Quantity Sold\"]) || 0;\n\n  const product = item.json[\"Product Name\"];\n  const category = item.json[\"Category\"];\n  const region = item.json[\"Region\"];\n\n  totalRevenue += sales;\n  totalQuantity += qty;\n\n  // Category Sales\n  categorySales[category] = (categorySales[category] || 0) + sales;\n\n  // Region Sales\n  regionSales[region] = (regionSales[region] || 0) + sales;\n\n  // Top Product\n  if (sales > topProductSales) {\n    topProductSales = sales;\n    topProduct = product;\n  }\n}\n\nlet topRegion = \"\";\nlet topRegionSales = 0;\n\nfor (const region in regionSales) {\n  if (regionSales[region] > topRegionSales) {\n    topRegionSales = regionSales[region];\n    topRegion = region;\n  }\n}\n\nlet topCategory = \"\";\nlet topCategorySales = 0;\n\nfor (const category in categorySales) {\n  if (categorySales[category] > topCategorySales) {\n    topCategorySales = categorySales[category];\n    topCategory = category;\n  }\n}\n\nreturn [{\n  json: {\n    TotalRevenue: totalRevenue,\n    TotalQuantity: totalQuantity,\n    TopProduct: topProduct,\n    TopRegion: topRegion,\n    TopCategory: topCategory,\n    AverageRevenue: (totalRevenue / items.length).toFixed(2)\n  }\n}];"
      },
